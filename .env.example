# Required: Claude decides (which company, which pages, the score). It does not search the web.
ANTHROPIC_API_KEY=
# Model for research judgements (default claude-sonnet-5-5, $2 in / $10 out per million tokens).
CLAUDE_MODEL=claude-sonnet-5-5
# Model for the chat assistant (default claude-haiku-5-5, about $0.001 per answer).
CHAT_MODEL=claude-haiku-5-5

# Required for web search: Exa's official API (https://dashboard.exa.ai, ~$0.007/search). No search engine is scraped.
EXA_API_KEY=

# Contact shown to website owners in the agent's User-Agent (a URL or email), e.g. https://yourcompany.com/bot
CRAWLER_CONTACT=

# Leads for accepted companies. Either or both.
# Hunter: https://hunter.io/api-keys (1 credit per email). Apollo: Settings > Integrations > API (about 1 credit per person).
HUNTER_API_KEY=
APOLLO_API_KEY=

# GDPR. Every outreach email and LinkedIn follow-up ends with a line saying where the person's details came from,
# how to opt out, and this link to your privacy policy (until it is set, the line shows a reminder instead).
PRIVACY_POLICY_URL=
# Leads are deleted this many days after they were found (or, if contacted, after the contact). Minimum 30.
RETENTION_DAYS=365

# Who outreach messages are signed by (otherwise "[Your name]").
SENDER_NAME=
SENDER_TITLE=
SENDER_COMPANY=

# Optional defaults so you don't retype them in the UI every time.
PRODUCT_DESCRIPTION=
IDEAL_CUSTOMER=

# Optional local reranker model (ONNX, downloaded once from Hugging Face).
# Xenova/bge-reranker-base (~280MB, default) or Xenova/ms-marco-MiniLM-L-6-v2 (~23MB, faster).
RERANK_MODEL=Xenova/bge-reranker-base

# Use another port (e.g. 3001) if 3000 is taken.
PORT=3000
